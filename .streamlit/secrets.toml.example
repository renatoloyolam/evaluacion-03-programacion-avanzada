# Copia este archivo como  .streamlit/secrets.toml  y reemplaza los valores.
# secrets.toml está en el .gitignore: no se sube a GitHub.
#
# URL : Supabase -> Project Settings -> Data API (o botón "Connect")
# KEY : Supabase -> Project Settings -> API Keys -> "Secret key" (empieza con sb_secret_...)
#       Usar la SECRETA: las tablas tienen RLS activado y la clave publishable no puede leerlas.

[supabase]
url = "https://TU-PROYECTO.supabase.co"
key = "sb_secret_REEMPLAZAR"
